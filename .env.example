# Supabase — shirwelldb project (https://supabase.com/dashboard)
# Project URL: https://uhjqyrftgljauuabupxb.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://uhjqyrftgljauuabupxb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional server-only key for admin scripts (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps — enable Maps JavaScript API and create a key at https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyClEQvEWmTm35oDnhdjIPsF6AG_a2sAQN0

# Google AdSense — https://www.google.com/adsense/
# Site readiness: /ads.txt, Privacy, Terms, About, Contact, cookie consent, sitemap
# 1. Create a Display ad unit in AdSense
# 2. Copy your publisher ID (ca-pub-...) and ad slot ID(s)
# 3. Deploy, then verify site + ads.txt in AdSense, then request review
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-2495432679632375
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=8197243699
NEXT_PUBLIC_ADSENSE_SLOT_BOX_AD=8197243699
# In-article (fluid) — used inside /guides/* articles
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=6607155384
# Optional: separate slot for homepage mid-content (defaults to ADSENSE_SLOT)
# NEXT_PUBLIC_ADSENSE_SLOT_INLINE=8197243699
# Matched content / related (autorelaxed)
NEXT_PUBLIC_ADSENSE_SLOT_MATCHED=5780185108
NEXT_PUBLIC_GTM_ID=GTM-MHNWRHJF
# Google tag (gtag.js) — from Google Ads / Tag installation instructions
NEXT_PUBLIC_GTAG_ID=GT-MKTBV8CX

# Google Reader Revenue Manager (Subscribe with Google / SWG Basic)
# Paste product ID from Publisher Center → Sync updates with your CMS
NEXT_PUBLIC_SWG_PRODUCT_ID=CAow5KfHDA:openaccess
# NEXT_PUBLIC_SWG_ENABLED=false
